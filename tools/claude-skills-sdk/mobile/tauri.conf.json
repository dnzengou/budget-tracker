{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Skills",
  "version": "0.1.0",
  "identifier": "com.dnzengou.claudeskills",
  "build": {
    "frontendDist": "../site"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Skills",
        "width": 420,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.anthropic.com https://api.openai.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
